            Student s = new Student(ime, b == 1, c == 1);

            if (a == 1) nauka.enqueue(s);
            else if (b == 1) sf.enqueue(s);
            else if (c == 1) ist.enqueue(s);
        }

        while (!nauka.isEmpty() || !sf.isEmpty() || !ist.isEmpty()) {

            for (int i = 0; i < 2 && !nauka.isEmpty(); i++) {
                Student s = nauka.dequeue();
                if (s.sf) sf.enqueue(s);
                else if (s.istorija) ist.enqueue(s);
