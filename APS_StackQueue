                if (s.istorija) ist.enqueue(s);
                else System.out.println(s.ime);
            }

            for (int i = 0; i < 2 && !ist.isEmpty(); i++) {
                Student s = ist.dequeue();
                System.out.println(s.ime);
            }
        }
    }
}




