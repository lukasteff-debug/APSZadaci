    boolean sf, istorija;

    public Student(String ime, boolean sf, boolean istorija) {
        this.ime = ime;
        this.sf = sf;
        this.istorija = istorija;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        ArrayQueue<Student> nauka = new ArrayQueue<>(1000);
