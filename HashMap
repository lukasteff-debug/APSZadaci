Секој проект да се печати во формат "<time, rate>" каде на местото на time и rate треба да стои работното време и платата по час на проектот соодветно (имплементирајте го ова во toString метод)

import java.util.*;

class Employee {
    String name;
    int age;

    Employee(String name, int age) {
        this.name = name;
        this.age = age;
    }

    @Override
    public String toString() {
        return "<" + name + ", " + age + ">";
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (!(o instanceof Employee)) return false;
        Employee e = (Employee) o;
        return age == e.age && name.equals(e.name);
    }

    @Override
    public int hashCode() {
        // За CBHT можеш и да го оставиш, ние користиме наша хеш функција
        return age * name.charAt(0);
    }
}

class Project {
    int time;
    int rate;

    Project(int time, int rate) {
        this.time = time;
        this.rate = rate;
    }

    int totalSalary() {
        return time * rate;
    }

    @Override
    public String toString() {
        return "<" + time + ", " + rate + ">";
    }
}


public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();

        CBHT<Employee, Project> table = new CBHT<>(10); // 10 кофички

        for (int i = 0; i < N; i++) {
            String name = sc.next();
            int age = sc.nextInt();
            int time = sc.nextInt();
            int rate = sc.nextInt();

            Employee e = new Employee(name, age);
            Project p = new Project(time, rate);

            
            SLLNode<MapEntry<Employee, Project>> existing = table.search(e);
            if (existing == null) {
                table.insert(e, p);
            } else {
               
                if (p.totalSalary() > existing.element.value.totalSalary()) {
                    table.insert(e, p);
                }
            }
        }

       
        System.out.println(table.toString());
    }
}


