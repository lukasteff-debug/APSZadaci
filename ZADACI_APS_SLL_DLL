public class Main{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        DLL<Integer> list = new DLL<>();
        for (int i = 0; i < N; i++) {
            list.insertLast(sc.nextInt());
        }
       DLLNode<Integer>node=list.getFirst();
        int counter=0;
        while(node!=null){
            float levo=0;
            float desno=0;
            int lc=0;
            int dc=0;
            DLLNode<Integer>left=node.pred;
            DLLNode<Integer>right=node.succ;
            while(left!=null){
                levo+=left.element;
                lc++;
                left=left.pred;
            }
            while(right!=null){
                desno+= right.element;
                dc++;
                right=right.succ;
            }
            float lp=levo/lc;
            float dp=desno/dc;
            if(lp>dp){
                counter++;
            }
            node=node.succ;
        }
        System.out.println(counter);

    }
}

